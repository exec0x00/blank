{
  "name": "claude-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLAUDE_VITE_DEV=1 tsx watch server/index.ts",
    "predev": "npm run build:native",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "prebuild": "npm run build:native",
    "build:native": "node scripts/build-native.mjs",
    "start": "node dist/server/index.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.309",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@huggingface/hub": "2.17.3",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/headless": "5.5.0",
    "@xterm/xterm": "5.5.0",
    "ajv": "^8.20.0",
    "compression": "^1.8.1",
    "cookie": "^1.0.2",
    "diff": "^8.0.2",
    "express": "^5.1.0",
    "ignore": "^7.0.5",
    "lucide-react": "^0.468.0",
    "mime-types": "^3.0.1",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "playwright-core": "1.63.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "1.8.0",
    "ws": "^8.18.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/compression": "^1.8.1",
    "@types/cookie": "^0.6.0",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.3",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
